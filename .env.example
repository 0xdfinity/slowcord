# Slowcord — copy to .env and fill in. Never commit .env.
# Both bot tokens are required to run the live bridge.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Model: Gemma through Google AI.
SLOW_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemma-3-27b-it

# Digest behavior
SLOW_INTERVAL_MIN=30
SLOW_OWNER_DISCORD_ID=
SLOW_MAX_BUFFER=200

# Health server (Render sets this automatically)
PORT=8787

# Sentry tracing (optional; leave empty to disable)
SENTRY_DSN=
SENTRY_ENV=development
